# PostgreSQL 18 Database URL (Runtime: app_user)
DATABASE_URL="postgres://app_user:dollshop_dev_password@localhost:5432/dollshop"
DATABASE_MAX_CONNECTIONS="10"

# Migration Database URL (DDL: app_owner)
DATABASE_OWNER_URL="postgres://app_owner:dollshop_owner_password@localhost:5432/dollshop"

# Optional local connection overrides
# PGHOST="/tmp"
# PGPORT="5433"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Cron secret for reservation expiration
CRON_SECRET="dev_cron_secret_dollshop_change_in_prod"

# Revalidation secret for on-demand ISR
REVALIDATE_SECRET="dev_revalidate_secret_dollshop_change_in_prod"

# Auth (Better Auth)
BETTER_AUTH_SECRET="dev_better_auth_secret_dollshop_local"
BETTER_AUTH_URL="http://localhost:3000"

# Storage (S3 hoster.by compatible)
# S3_ENDPOINT="https://s3.hoster.by"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_MEDIA="dollshop-media"
