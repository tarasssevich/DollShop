# Public URL
NEXT_PUBLIC_SITE_URL=https://brand.by
NEXT_PUBLIC_MEDIA_BASE_URL=https://brand.by/media

# Database (PostgreSQL 18)
DATABASE_URL=postgres://app_user:app_password@localhost:5432/dollshop
DATABASE_OWNER_URL=postgres://app_owner:owner_password@localhost:5432/dollshop

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-32-char-random-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# S3 Storage (hoster.by / S3 compatible)
S3_ENDPOINT=https://s3.hoster.by
S3_REGION=by-minsk-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET_MEDIA=dollshop-media
S3_BUCKET_BACKUPS=dollshop-backups

# Telegram Notifications
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# AI (Google Gemini 1.5 Pro via Google AI Pro subscription)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_PROXY_URL=https://your-cf-worker.workers.dev
GEMINI_MODEL=gemini-1.5-pro

# Internal Secrets
CRON_SECRET=your-cron-secret-key
REVALIDATE_SECRET=your-revalidate-secret-key
BACKUP_ENCRYPTION_KEY=your-backup-aes256-key
