# Расписание фоновых задач DollShop (Europe/Minsk, UTC+3)
#
# 1. Каждую минуту: освобождение истёкших броней кукол в PostgreSQL и сброс ISR-кэша витрины
* * * * * curl -s -f -X POST -H "Authorization: Bearer __CRON_SECRET__" "__WEB_URL__/api/cron/expire-reservations" >> /var/log/cron.log 2>&1

# 2. Каждые 10 минут: опрос healthcheck для локального логирования доступности
*/10 * * * * curl -s -f "__WEB_URL__/api/health" > /dev/null 2>&1

# 3. Ежедневно в 04:00 утра: создание резервной копии базы данных (Step 7.5)
# 0 4 * * * /app/backup.sh >> /var/log/backup.log 2>&1
